{
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "agent_servers": {
    "autohand": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "agent": "default",
        "effort": "max",
        "mode": "auto",
        "model": "opus",
      },
      "type": "registry",
    },
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 22.0,
  "collaboration_panel": {
    "dock": "left",
  },
  "context_servers": {},
  "edit_predictions": {
    "provider": "zed",
  },
  "extend_comment_on_newline": false,
  "file_scan_exclusions": [
    "**/.venv",
    "**/.zed",
    "**/.ipynb_checkpoints",
    ".python-version",
  ],
  "git_panel": {
    "dock": "left",
  },
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "arguments": ["--stdin-filepath", "{buffer_path}"],
          "command": "prettier",
        },
      },
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "hide_gitignore": true,
    "dock": "left",
  },
  "terminal": {
    "copy_on_select": true,
    "dock": "bottom",
    "working_directory": "current_project_directory",
  },
  "theme": {
    "dark": "Everforest Dark Medium (material)",
    "light": "Tokyo Night",
    "mode": "dark",
  },
  "ui_font_size": 23,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 18,
  "vim_mode": true,
}
